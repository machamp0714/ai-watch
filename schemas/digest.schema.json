{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "mode": {"type": "string", "enum": ["triaged", "untriaged"]},
    "items_total": {"type": "integer", "minimum": 0},
    "items_shown": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "trends": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {"type": "string"},
          "count": {"type": "integer", "minimum": 0},
          "sources": {"type": "array", "items": {"type": "string"}},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {"type": "string"},
                "url": {"type": "string"},
                "source": {"type": "string"},
                "summary": {"type": "array", "items": {"type": "string"}}
              },
              "required": ["title", "url", "source", "summary"],
              "additionalProperties": false
            }
          }
        },
        "required": ["label", "count", "sources", "items"],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "object",
      "properties": {
        "try": {"$ref": "#/$defs/items"},
        "update": {"$ref": "#/$defs/items"},
        "read": {"$ref": "#/$defs/items"},
        "overflow": {"$ref": "#/$defs/items"}
      },
      "required": ["try", "update", "read", "overflow"],
      "additionalProperties": false
    }
  },
  "required": ["date", "mode", "items_total", "items_shown", "cost_usd", "warnings", "sections"],
  "additionalProperties": false,
  "$defs": {
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^aw-[0-9a-f]{8}$"},
        "title": {"type": "string"},
        "url": {"type": "string"},
        "source": {"type": "string"},
        "mentions": {"type": "array", "items": {"type": "string"}},
        "lang": {"type": "string"},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "reason": {"type": "string"},
        "summary": {"type": "array", "items": {"type": "string"}},
        "try_plan": {"type": "string"},
        "article_angle": {"type": "string"},
        "published_at": {"type": ["string", "null"]}
      },
      "required": ["id", "title", "url", "source", "mentions", "lang", "score", "reason", "summary", "try_plan", "article_angle", "published_at"],
      "additionalProperties": false
    }
  }
}
