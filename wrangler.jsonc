{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-watch",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "AI_WATCH_BUCKET",
      "bucket_name": "ai-watch-prod"
    }
  ]
}
